#!/usr/bin/env bash
# prepare-commit-msg — Appends AI attribution trailers to the commit message.
#
# Reads .kiro-attribution-staged.json (written by pre-commit) and adds:
#   ai-authored-by: kiro
#   ai-authorship: generated | assisted | human-only
#   ai-lines: N
#   human-lines: M
#
# Install: symlink or copy to .git/hooks/prepare-commit-msg
#   ln -sf ../../scripts/hooks/prepare-commit-msg .git/hooks/prepare-commit-msg

set -euo pipefail

COMMIT_MSG_FILE="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"
ATTRIBUTION_SUMMARY="${REPO_ROOT}/.kiro-attribution-staged.json"

# Remove any attribution trailers already present in the message, then trim the
# trailing blank lines they left behind.
#
# This hook can legitimately run more than once against the same message file —
# on `git commit --amend`, on a commit retried after a failed hook, or when an
# IDE/client re-invokes it — and without this the trailer block gets appended
# again, producing a duplicated block. Call it immediately before appending, and
# never on a path that exits without appending, so an amend that has no fresh
# attribution summary keeps the trailers it already had.
strip_attribution_trailers() {
  local file="$1" tmp
  tmp="$(mktemp)"
  grep -v -E '^(ai-authored-by|ai-authorship|ai-lines|human-lines|ai-attribution):' \
    "$file" > "$tmp" || true
  # Drop trailing blank lines so the re-appended block keeps its original spacing.
  awk '{ lines[NR] = $0 }
       END { last = NR
             while (last > 0 && lines[last] ~ /^[[:space:]]*$/) last--
             for (i = 1; i <= last; i++) print lines[i] }' "$tmp" > "$file"
  rm -f "$tmp"
}

# If no attribution summary, nothing to add
if [ ! -f "$ATTRIBUTION_SUMMARY" ]; then
  exit 0
fi

STATE=$(jq -r '.attribution_state // "measured"' "$ATTRIBUTION_SUMMARY")

# Attribution could not be determined (capture not working in this client).
# Emit a distinct marker and deliberately omit ai-lines/human-lines, so parsers
# exclude this commit from the authorship rate instead of counting every line as
# human — which is what makes broken capture look like a productive human.
if [ "$STATE" = "unknown" ]; then
  strip_attribution_trailers "$COMMIT_MSG_FILE"
  {
    echo ""
    echo ""
    echo "ai-attribution: unknown"
  } >> "$COMMIT_MSG_FILE"
  exit 0
fi

AI_LINES=$(jq -r '.ai_lines' "$ATTRIBUTION_SUMMARY")
HUMAN_LINES=$(jq -r '.human_lines' "$ATTRIBUTION_SUMMARY")
TOTAL_LINES=$(jq -r '.total_lines' "$ATTRIBUTION_SUMMARY")

# Skip if no lines at all
if [ "$TOTAL_LINES" -eq 0 ]; then
  exit 0
fi

# Determine authorship category
if [ "$HUMAN_LINES" -eq 0 ] && [ "$AI_LINES" -gt 0 ]; then
  CATEGORY="generated"
elif [ "$AI_LINES" -gt 0 ] && [ "$HUMAN_LINES" -gt 0 ]; then
  CATEGORY="assisted"
else
  CATEGORY="human-only"
fi

# Append trailers (git recognizes lines matching "key: value" at end of message)
strip_attribution_trailers "$COMMIT_MSG_FILE"
{
  echo ""
  echo ""
  if [ "$CATEGORY" != "human-only" ]; then
    echo "ai-authored-by: kiro"
  fi
  echo "ai-authorship: ${CATEGORY}"
  echo "ai-lines: ${AI_LINES}"
  echo "human-lines: ${HUMAN_LINES}"
} >> "$COMMIT_MSG_FILE"

exit 0
