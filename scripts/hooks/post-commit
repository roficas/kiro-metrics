#!/usr/bin/env bash
# post-commit — Stores line-level attribution as a git note and cleans up tracking files.
#
# Flow:
#   1. Reads .kiro-attribution-staged.json (written by pre-commit)
#   2. Attaches the attribution data as a git note on the new commit
#   3. Clears .kiro-attribution.json and .kiro-attribution-staged.json
#
# Install: symlink or copy to .git/hooks/post-commit
#   ln -sf ../../scripts/hooks/post-commit .git/hooks/post-commit

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
TRACKING_FILE="${REPO_ROOT}/.kiro-attribution.json"
ATTRIBUTION_SUMMARY="${REPO_ROOT}/.kiro-attribution-staged.json"

# If no summary exists, nothing to record
if [ ! -f "$ATTRIBUTION_SUMMARY" ]; then
  exit 0
fi

AI_LINES=$(jq -r '.ai_lines' "$ATTRIBUTION_SUMMARY")
TOTAL_LINES=$(jq -r '.total_lines' "$ATTRIBUTION_SUMMARY")

# Only add a note if there was AI involvement
if [ "$AI_LINES" -gt 0 ]; then
  COMMIT_SHA=$(git rev-parse HEAD)
  NOTE_CONTENT=$(jq -c '.' "$ATTRIBUTION_SUMMARY")

  # Add git note with attribution data (namespace: ai-attribution)
  git notes --ref=ai-attribution add -m "$NOTE_CONTENT" "$COMMIT_SHA" 2>/dev/null || \
    git notes --ref=ai-attribution append -m "$NOTE_CONTENT" "$COMMIT_SHA" 2>/dev/null || true

  echo "[attribution] Recorded AI attribution note on ${COMMIT_SHA:0:8}"
fi

# Clear the edit log for the next cycle, but PRESERVE the session marker.
# Dropping it would make every commit after the first in a session look like capture
# had broken, forcing them all to 'unknown'.
if [ -f "$TRACKING_FILE" ] && jq -e . "$TRACKING_FILE" >/dev/null 2>&1; then
  jq '{session: (.session // empty), edits: []}' "$TRACKING_FILE" > "${TRACKING_FILE}.tmp" \
    && mv "${TRACKING_FILE}.tmp" "$TRACKING_FILE"
else
  echo '{"edits":[]}' > "$TRACKING_FILE"
fi
rm -f "$ATTRIBUTION_SUMMARY"

exit 0
