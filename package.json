{
  "name": "kiro-metrics",
  "version": "0.1.0",
  "description": "CLI tool that reads AI code attribution data from git repos and produces four-tier metrics reports",
  "type": "module",
  "bin": {
    "kiro-metrics": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "metrics": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "hooks:install": "./scripts/hooks/install-hooks.sh",
    "push-notes": "git push origin refs/notes/ai-attribution",
    "report": "./scripts/report.sh",
    "report:team": "./scripts/report.sh team",
    "report:board": "./scripts/report.sh board",
    "report:all": "./scripts/report.sh all"
  },
  "dependencies": {
    "commander": "13.1.0"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  },
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "https://github.com/roficas/kiro-metrics"
  }
}
